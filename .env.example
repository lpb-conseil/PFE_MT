# Copier vers .env et compléter. NE JAMAIS committer le .env réel.

# --- Wazuh (API manager, port 55000) ---
# WAZUH_USER = utilisateur de l'API Wazuh (RBAC), différent du compte 'admin'
# de l'indexeur/Dashboard. Accès distant possible via l'IP overlay NetBird de la VM.
WAZUH_API_URL=https://192.168.10.161:55000
WAZUH_USER=wazuh
WAZUH_PASSWORD=
# Requis uniquement si Wazuh >= 4.8 (endpoint /vulnerability supprimé) :
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=

# --- iTop (REST, basic auth) ---
ITOP_URL=https://cdsdev.nuage-lpb.com/itop
ITOP_USER=
ITOP_PASSWORD=
# Filtre organisation appliqué côté Python (vide = toutes) :
ITOP_ORG_FILTER=LPB Conseil,LPB Groupe

# --- CISO Assistant (token API) ---
CISO_URL=https://ciso-lpbgroupe.nuage-lpb.com
CISO_TOKEN=

# --- Application ---
COLLECT_INTERVAL_MIN=15
COLLECT_ON_STARTUP=1
# Certificats auto-signés réseau interne -> 0
VERIFY_TLS=0
